# ═══════════════════════════════════════════════════════════════════════════════
# Apex Nexus — Root Environment Reference
# Copy per-service .env.example files into their respective service directories.
# This file documents ALL variables across all services for reference.
# ═══════════════════════════════════════════════════════════════════════════════


# ─── services/apex-rag (.env) ─────────────────────────────────────────────────

# Storage
APEX_RAG_PERSIST_DIR=./chroma_db
APEX_RAG_COLLECTION=apex_default

# Embedding backend: 'ollama' (recommended) or 'local' (sentence-transformers)
APEX_RAG_EMBED_BACKEND=ollama

# Ollama embedding model (embed_backend=ollama)
# Pull: ollama pull nomic-embed-text
APEX_RAG_OLLAMA_EMBED_MODEL=nomic-embed-text

# Local embedding model (embed_backend=local only)
APEX_RAG_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
APEX_RAG_EMBED_MODEL_DIR=./models
APEX_RAG_EMBED_DEVICE=cpu
APEX_RAG_EMBED_BATCH_SIZE=64

# Chunking
APEX_RAG_CHUNK_SIZE=512
APEX_RAG_CHUNK_OVERLAP=64

# Retrieval
APEX_RAG_TOP_K=5

# Hybrid search (BM25 + semantic)
APEX_RAG_HYBRID_SEARCH=false
APEX_RAG_HYBRID_SEMANTIC_WEIGHT=1.0
APEX_RAG_HYBRID_BM25_WEIGHT=1.0

# Reranking
APEX_RAG_RERANK=false
APEX_RAG_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Embedding cache
APEX_RAG_EMBED_CACHE=false
APEX_RAG_EMBED_CACHE_DIR=./embedding_cache

# Deduplication
APEX_RAG_DEDUP=false
APEX_RAG_DEDUP_STORE_DIR=./dedup_store

# Ollama LLM (leave empty to disable generation; retrieval still works)
APEX_RAG_OLLAMA_MODEL=
APEX_RAG_OLLAMA_HOST=http://localhost:11434


# ─── services/apex-identity (.env) ────────────────────────────────────────────

# Secret key for JWT signing — generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-random-secret

# JWT expiry in minutes (default: 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SQLite database path
DATABASE_URL=sqlite:///./apex_identity.db

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Server bind
HOST=0.0.0.0
PORT=8001


# ─── services/apex-gateway (.env) ─────────────────────────────────────────────

APEX_GW_OLLAMA_HOST=http://localhost:11434
APEX_GW_OLLAMA_MODEL=gemma4:e2b
APEX_GW_HOST=0.0.0.0
APEX_GW_PORT=8002


# ─── services/apex-agents (.env) ──────────────────────────────────────────────

APEX_AGENTS_HOST=0.0.0.0
APEX_AGENTS_PORT=8003
APEX_AGENTS_DB_URL=sqlite:///./apex_agents.db
APEX_AGENTS_GATEWAY_URL=http://localhost:8002
APEX_AGENTS_RAG_URL=http://localhost:8000
APEX_AGENTS_OLLAMA_HOST=http://localhost:11434
APEX_AGENTS_OLLAMA_MODEL=gemma4:e2b
APEX_AGENTS_CORS_ORIGINS=http://localhost:5173,http://localhost:3000


# ─── apps/apex-portal (.env) ──────────────────────────────────────────────────

VITE_RAG_URL=http://localhost:8000
VITE_IDENTITY_URL=http://localhost:8001
VITE_GATEWAY_URL=http://localhost:8002
VITE_AGENTS_URL=http://localhost:8003


# ─── Structured logging (all Python services) ────────────────────────────────

# console = human-readable coloured output (default for local dev)
# json    = one JSON object per line (recommended for Docker / production)
APEX_LOG_FORMAT=console

# DEBUG | INFO | WARNING | ERROR
APEX_LOG_LEVEL=INFO

# OTLP HTTP base URL — empty disables OpenTelemetry
# With Docker: docker compose --profile observability up  (starts Jaeger on :4318)
# UI at http://localhost:16686
APEX_LOG_OTLP_ENDPOINT=
