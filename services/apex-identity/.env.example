# ─── Apex Identity Configuration ─────────────────────────────────

# Secret key for signing JWT tokens (generate with: python -c "import secrets; print(secrets.token_urlsafe(64))")
SECRET_KEY=change-me-to-a-random-secret

# JWT token expiry in minutes (default: 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database URL (default: SQLite file in project root)
DATABASE_URL=sqlite:///./apex_identity.db

# CORS allowed origins (comma-separated, default allows localhost dev servers)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Server host and port
HOST=0.0.0.0
PORT=8001
