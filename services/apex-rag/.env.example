# Storage
APEX_RAG_PERSIST_DIR=./chroma_db
APEX_RAG_COLLECTION=apex_default

# Embedding backend — 'ollama' is recommended (fully local, no HuggingFace)
# Alternative: 'local' uses sentence-transformers (downloads model from HuggingFace on first run)
APEX_RAG_EMBED_BACKEND=ollama

# Ollama embedding model (embed_backend=ollama)
# Pull before use:  ollama pull nomic-embed-text
# Faster/smaller:   ollama pull all-minilm  (23 MB, 384-dim)
APEX_RAG_OLLAMA_EMBED_MODEL=nomic-embed-text

# Local embedding model (embed_backend=local only)
APEX_RAG_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Model weights are downloaded here on first run and reused offline after that.
# This directory is gitignored — do not commit it.
APEX_RAG_EMBED_MODEL_DIR=./models
APEX_RAG_EMBED_DEVICE=cpu
APEX_RAG_EMBED_BATCH_SIZE=64

# Chunking
APEX_RAG_CHUNK_SIZE=512
APEX_RAG_CHUNK_OVERLAP=64

# Retrieval
APEX_RAG_TOP_K=5

# Phase 2 — Hybrid search
APEX_RAG_HYBRID_SEARCH=false
APEX_RAG_HYBRID_SEMANTIC_WEIGHT=1.0
APEX_RAG_HYBRID_BM25_WEIGHT=1.0

# Phase 2 — Reranking
APEX_RAG_RERANK=false
APEX_RAG_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Phase 2 — Embedding cache
APEX_RAG_EMBED_CACHE=false
APEX_RAG_EMBED_CACHE_DIR=./embedding_cache

# Phase 2 — Deduplication
APEX_RAG_DEDUP=false
APEX_RAG_DEDUP_STORE_DIR=./dedup_store

# Ollama LLM (leave empty to disable generation; retrieval still works)
APEX_RAG_OLLAMA_MODEL=
APEX_RAG_OLLAMA_HOST=http://localhost:11434
